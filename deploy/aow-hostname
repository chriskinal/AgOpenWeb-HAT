#
# Sets this unit's hostname, which is also its name on the network: http://NAME.local/ (avahi).
#
#   aow-hostname NAME
#
# Run as root by install.sh and by aow-hatd (the Network page). NAME is one DNS label: lowercase
# letters, digits and hyphens, at most 63, not starting or ending with a hyphen.
#
# On Raspberry Pi OS set up by Raspberry Pi Imager (Trixie), cloud-init writes /etc/hosts again
# at every boot, with the name the Imager gave, from its own cached copy of the Imager's settings.
# Its first-boot work is done by the time this runs, so it is switched off
# (/etc/cloud/cloud-init.disabled; delete that file to switch it back on).
set -euo pipefail

name="${1:-}"
if ! [[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
  echo "not a valid hostname: lowercase letters, digits and hyphens, at most 63, not starting or ending with a hyphen" >&2
  exit 2
fi
[ "$(id -u)" -eq 0 ] || { echo "run as root (sudo)" >&2; exit 1; }

# hostnamectl needs systemd-hostnamed (D-Bus); without it, the file and the kernel's name.
if ! hostnamectl set-hostname "$name" 2>/dev/null; then
  echo "$name" > /etc/hostname
  hostname "$name"
fi

# The name resolves on the unit itself (sudo looks it up): Debian's 127.0.1.1 line.
if grep -q '^[[:space:]]*127\.0\.1\.1[[:space:]]' /etc/hosts; then
  # Written in place, not renamed over (a container bind-mounts it).
  tmp="$(mktemp)"
  sed "s/^[[:space:]]*127\.0\.1\.1[[:space:]].*/127.0.1.1\t$name/" /etc/hosts > "$tmp"
  cat "$tmp" > /etc/hosts
  rm -f "$tmp"
else
  printf '127.0.1.1\t%s\n' "$name" >> /etc/hosts
fi

if [ -d /etc/cloud ] && [ ! -e /etc/cloud/cloud-init.disabled ]; then
  echo "Written by aow-hostname: cloud-init would put the Imager's hostname back in /etc/hosts at every boot." \
    > /etc/cloud/cloud-init.disabled
fi

# avahi does not follow a hostname change by itself.
systemctl try-restart avahi-daemon.service 2>/dev/null || true
echo "Hostname set: $name (http://$name.local/)"
